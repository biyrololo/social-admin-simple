doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title || 'Администрирование социальной сети'}
    link(rel="stylesheet" href="css/style.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
  body
    #globalProgressBar.global-progress-bar

    nav.navbar.navbar-expand-lg.sticky-top
      .container
        a.navbar-brand(href="index.html")
          span.brand-icon
            i.bi.bi-people-fill
          span Social Admin
        
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon
        
        .collapse.navbar-collapse#navbarContent
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link#nav-users(href="index.html")
                i.bi.bi-person-lines-fill.me-1
                | Пользователи
            li.nav-item
              a.nav-link#nav-friends(href="friends.html")
                i.bi.bi-people.me-1
                | Друзья
            li.nav-item
              a.nav-link#nav-news(href="news.html")
                i.bi.bi-newspaper.me-1
                | Новости друзей

    main.container
      block content

    block modals

    .modal.fade#confirmModal(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header
            h5.modal-title#confirmModalTitle Подтверждение
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body
            p.mb-0#confirmModalMessage Вы уверены?
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Отмена
            button.btn.btn-danger#confirmModalOkBtn(type="button") Подтвердить

    .toast-container.position-fixed.bottom-0.end-0.p-3
      .toast#app-toast(role="alert" aria-live="assertive" aria-atomic="true")
        .toast-header
          i.bi.bi-info-circle-fill.me-2#toast-icon
          strong.me-auto#toast-title Уведомление
          small#toast-time сейчас
          button.btn-close(type="button" data-bs-dismiss="toast" aria-label="Close")
        .toast-body#toast-body Операция выполнена успешно!

    footer
      .container.text-center
        p.mb-1 Лабораторная работа №3 • Администрирование социальной сети

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="js/bundle.min.js")
